# Публичные (доступны в браузере)
NUXT_PUBLIC_SITE_URL=http://localhost:3000
NUXT_PUBLIC_YANDEX_PAY_MERCHANT_ID=
NUXT_PUBLIC_YANDEX_PAY_SANDBOX=true
NUXT_PUBLIC_YANDEX_OAUTH_CLIENT_ID=

# PostgreSQL (Docker: ../shop_DB)
# Либо NUXT_DATABASE_URL, либо DATABASE_URL
NUXT_DATABASE_URL=postgresql://amateru:amateru_dev@localhost:5432/amateru
DATABASE_URL=postgresql://amateru:amateru_dev@localhost:5432/amateru
# DB_POOL_MAX=10

# Серверные секреты (только Nitro)
NUXT_YANDEX_OAUTH_CLIENT_ID=
NUXT_YANDEX_OAUTH_CLIENT_SECRET=
NUXT_YANDEX_PAY_MERCHANT_ID=
NUXT_YANDEX_PAY_API_KEY=
NUXT_YANDEX_PAY_SANDBOX=true
# CARD,SPLIT или CARD,SPLIT,SBPPAY
NUXT_YANDEX_PAY_METHODS=CARD,SPLIT
# Ставка НДС в чеке: 1 = 20%, 6 = НДС не облагается
NUXT_YANDEX_PAY_RECEIPT_TAX=6

# Склад для Яндекс Доставки (чек-аут Яндекса считает тариф сам)
NUXT_YANDEX_WAREHOUSE_LOCALITY=Москва
NUXT_YANDEX_WAREHOUSE_REGION=Москва
NUXT_YANDEX_WAREHOUSE_ZIP=
NUXT_YANDEX_WAREHOUSE_STREET=
NUXT_YANDEX_WAREHOUSE_BUILDING=
NUXT_YANDEX_WAREHOUSE_ADDRESS_LINE=
NUXT_YANDEX_WAREHOUSE_PHONE=
NUXT_YANDEX_WAREHOUSE_CONTACT_NAME=amateru.st
NUXT_YANDEX_WAREHOUSE_EMAIL=

# Redirect URI для приложения на oauth.yandex.ru:
# https://YOUR_DOMAIN/api/auth/yandex/callback
# Локально: http://localhost:3000/api/auth/yandex/callback
#
# Права (scopes) при регистрации:
# login:info, login:email, login:birthday, login:default_phone
#
# Callback URL в кабинете Яндекс Пэй (без суффикса /v1/webhook):
# https://YOUR_DOMAIN
