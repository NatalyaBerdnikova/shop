# Публичные (доступны в браузере)
NUXT_PUBLIC_FREE_DELIVERY_MIN_CENTS=800000
NUXT_PUBLIC_YANDEX_MAPS_API_KEY=
NUXT_PUBLIC_CDEK_WIDGET_SERVICE_URL=/api/delivery/cdek-proxy
NUXT_PUBLIC_YANDEX_OAUTH_CLIENT_ID=

# Серверные секреты (только Nitro)
NUXT_CDEK_ACCOUNT=
NUXT_CDEK_SECURE_PASSWORD=
NUXT_YANDEX_DELIVERY_TOKEN=
NUXT_YANDEX_OAUTH_CLIENT_ID=
NUXT_YANDEX_OAUTH_CLIENT_SECRET=

# Redirect URI для приложения на oauth.yandex.ru:
# https://YOUR_DOMAIN/api/auth/yandex/callback
# Локально: http://localhost:3000/api/auth/yandex/callback
#
# Права (scopes) при регистрации:
# login:info, login:email, login:birthday, login:default_phone
