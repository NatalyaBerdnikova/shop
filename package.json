    "db:down": "docker compose -f ../shop_DB/docker-compose.yml down",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:check": "drizzle-kit check"
  },
  "dependencies": {
    "@artmizu/nuxt-prometheus": "^3.0.0",
    "@dargmuesli/nuxt-cookie-control": "^9.1.18",
    "@nuxt/a11y": "^1.0.0-alpha.1",
    "@nuxt/eslint": "^1.15.2",
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/hints": "^1.0.0",
    "@nuxt/image": "^2.0.0",
    "@nuxt/scripts": "^0.13.2",
    "@nuxt/test-utils": "^4.0.0",
    "@nuxtjs/svg-sprite": "^1.0.2",
    "@pinia/nuxt": "^0.11.3",
    "drizzle-orm": "^0.45.3",
    "jose": "^6.2.12",
    "nuxt": "^4.4.2",
